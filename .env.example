# En production : URL HTTPS exacte, sans chemin (ex. https://budget.example.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=

# Secret serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Assistant IA (optionnel : l'analyse locale fonctionne sans clé)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MODEL=gpt-5.6-luna

# Optionnel : logos de marque HD pour tous les domaines reconnus par l'IA.
# Créer un Client ID gratuit dans Brandfetch. Sans cette valeur, un favicon
# officiel est utilisé et les marques principales gardent un logo vérifié.
BRANDFETCH_CLIENT_ID=
