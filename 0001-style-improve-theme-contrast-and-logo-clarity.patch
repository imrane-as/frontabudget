From db7b9e0020802d456d03971d70ec04fdb59b3ebf Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 23 Aug 2026 22:22:51 +0300
Subject: [PATCH] style: improve theme contrast and logo clarity

---
 app/globals.css | 359 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 359 insertions(+)

diff --git a/app/globals.css b/app/globals.css
index c1b38bd..006d351 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -4599,3 +4599,362 @@ html.light .auth-wrap { background: radial-gradient(circle at 50% 10%, rgba(7,15
   .landing-preview-row { grid-template-columns: 1fr; }
   .landing-trust-clean { margin-inline: 0; }
 }
+
+/* Balanced contrast system — v4 */
+:root {
+  --bg: #0b1421;
+  --panel: #121f30;
+  --panel-2: #192a3d;
+  --text: #f5f7fb;
+  --muted: #b2c0d1;
+  --line: rgba(188, 205, 224, .24);
+  --brand: #3bd69a;
+  --brand-soft: rgba(59, 214, 154, .13);
+}
+
+body {
+  color: var(--text);
+  background:
+    radial-gradient(circle at 88% 0, rgba(59, 214, 154, .09), transparent 29%),
+    radial-gradient(circle at 12% 42%, rgba(74, 144, 226, .07), transparent 31%),
+    linear-gradient(145deg, #0b1421 0%, #0d1827 52%, #0b1421 100%);
+}
+
+input::placeholder,
+textarea::placeholder {
+  color: #8fa2b8;
+  opacity: 1;
+}
+
+.brand-logo {
+  width: 202px;
+  height: 48px;
+  border: 1px solid rgba(219, 228, 238, .88);
+  border-radius: 13px;
+  background: linear-gradient(180deg, #f8fafc, #e7edf4);
+  box-shadow: 0 10px 28px rgba(0, 0, 0, .2), inset 0 1px 0 #fff;
+}
+
+.brand-logo img {
+  left: 8px;
+  width: calc(100% - 16px);
+}
+
+.brand-logo-compact {
+  width: 142px;
+  height: 38px;
+  border-radius: 10px;
+}
+
+.sidebar .logo .brand-logo { width: 214px; }
+.auth-brand,
+.auth-brand .brand-logo { width: 214px; }
+.marketing-nav-clean .marketing-brand,
+.marketing-nav-clean .brand-logo { width: 214px; }
+
+.sidebar {
+  border-right-color: rgba(188, 205, 224, .19);
+  background:
+    radial-gradient(circle at 18% 5%, rgba(59, 214, 154, .09), transparent 23%),
+    #0d1725;
+}
+
+.sidebar-label { color: #9fb0c4; }
+.nav a { color: #c2cedb; }
+.nav-icon { color: #9badc1; border-color: rgba(188, 205, 224, .16); }
+.nav a:hover { border-color: rgba(188, 205, 224, .23); background: rgba(255, 255, 255, .055); }
+.nav a.active { color: #ffffff; border-color: rgba(59, 214, 154, .3); background: linear-gradient(100deg, rgba(59, 214, 154, .18), rgba(74, 144, 226, .08)); }
+
+.app-topbar {
+  border-bottom-color: rgba(188, 205, 224, .18);
+  background: rgba(13, 23, 37, .9);
+}
+
+.topbar-status strong,
+.month-progress-card strong,
+.card h3,
+.page-intro h1 { color: var(--text); }
+
+.topbar-status div span,
+.page-intro p,
+.month-progress-card > div:first-child,
+.month-progress-card small,
+.dashboard-quick-actions small,
+.income-disclaimer,
+.hero-proof { color: var(--muted); }
+
+.theme-toggle,
+.profile-menu-trigger,
+.month-progress-card,
+.dashboard-quick-actions > a {
+  border-color: rgba(188, 205, 224, .22);
+  color: var(--text);
+  background: rgba(24, 40, 61, .88);
+}
+
+.profile-dropdown {
+  border-color: rgba(188, 205, 224, .24);
+  background: #101c2b;
+}
+
+.profile-dropdown-section > a,
+.profile-dropdown-section .theme-toggle,
+.profile-logout { color: #d6e0eb; }
+
+.card,
+.grocery-market-card,
+.income-ideas-card,
+.transaction-dialog {
+  border-color: rgba(188, 205, 224, .21);
+  background:
+    linear-gradient(155deg, rgba(255, 255, 255, .045), transparent 42%),
+    linear-gradient(180deg, #162438, #111d2e);
+  box-shadow: 0 20px 55px rgba(0, 0, 0, .22), inset 0 1px 0 rgba(255, 255, 255, .05);
+}
+
+.page-intro,
+.finance-hero {
+  border-color: rgba(var(--intro, 59, 214, 154), .3);
+  background:
+    radial-gradient(circle at 88% 8%, rgba(var(--intro, 59, 214, 154), .15), transparent 34%),
+    linear-gradient(125deg, #17263a, #111d2e);
+}
+
+.safe-spend-grid > div,
+.weather-days > div,
+.goal-line,
+.budget-line,
+.preference-card,
+.threshold-panel,
+.grocery-price,
+.income-idea,
+.profile-photo-panel,
+.landing-preview-row > div {
+  border-color: rgba(188, 205, 224, .18);
+  background: rgba(8, 18, 31, .42);
+}
+
+.dashboard-details { border-color: rgba(188, 205, 224, .2); background: rgba(18, 31, 48, .82); }
+.grocery-price > strong { color: #9af0cd; }
+.income-disclaimer { font-size: 9px; }
+.transaction-privacy { color: var(--muted); }
+.marketing-nav nav a,
+.marketing-login { color: #b2c0d1; }
+.marketing-nav nav a:hover,
+.marketing-login:hover { color: #ffffff; }
+
+input,
+select,
+textarea {
+  border-color: rgba(188, 205, 224, .25);
+  color: var(--text);
+  background: #0e1a2a;
+}
+
+input:hover,
+select:hover,
+textarea:hover { border-color: rgba(188, 205, 224, .42); }
+
+input:focus,
+select:focus,
+textarea:focus {
+  border-color: rgba(59, 214, 154, .72);
+  background: #101e30;
+  box-shadow: 0 0 0 4px rgba(59, 214, 154, .12);
+}
+
+.btn {
+  border-color: rgba(188, 205, 224, .24);
+  color: var(--text);
+  background: #18283d;
+}
+
+.btn-primary {
+  border-color: transparent;
+  color: #06231b;
+  background: linear-gradient(135deg, #70edbe, #3bd69a);
+}
+
+.landing-dashboard-preview {
+  border-color: rgba(188, 205, 224, .23);
+  background: linear-gradient(160deg, #17263a, #101b2a);
+}
+
+html.light {
+  color-scheme: light;
+  --bg: #e8edf3;
+  --panel: #f4f7fa;
+  --panel-2: #e1e8ef;
+  --text: #14283f;
+  --muted: #455d75;
+  --line: #becad7;
+  --brand: #087a4b;
+  --brand-soft: rgba(8, 122, 75, .1);
+}
+
+html.light body {
+  color: var(--text);
+  background:
+    radial-gradient(circle at 84% 0, rgba(8, 122, 75, .07), transparent 30%),
+    radial-gradient(circle at 15% 40%, rgba(41, 105, 176, .06), transparent 31%),
+    linear-gradient(145deg, #e8edf3, #edf1f5 48%, #e5ebf1);
+}
+
+html.light input::placeholder,
+html.light textarea::placeholder { color: #708399; }
+
+html.light .brand-logo {
+  border-color: #b9c6d3;
+  background: linear-gradient(180deg, #f6f8fa, #e7edf3);
+  box-shadow: 0 8px 22px rgba(42, 61, 82, .12), inset 0 1px 0 #fff;
+}
+
+html.light .sidebar {
+  border-right-color: #bcc8d4;
+  background:
+    radial-gradient(circle at 18% 5%, rgba(8, 122, 75, .07), transparent 24%),
+    rgba(237, 242, 247, .97);
+  box-shadow: 16px 0 45px rgba(42, 61, 82, .07);
+}
+
+html.light .sidebar-label { color: #61768d; }
+html.light .nav a { color: #334d68; }
+html.light .nav-icon { border-color: #c6d1dc; color: #536b83; background: #e2e9f0; }
+html.light .nav a:hover { border-color: #bdc9d5; color: #14283f; background: #e1e8ef; }
+html.light .nav a.active { border-color: rgba(8, 122, 75, .25); color: #075c3b; background: rgba(8, 122, 75, .1); }
+
+html.light .app-topbar {
+  border-bottom-color: #bdc9d5;
+  background: rgba(232, 237, 243, .92);
+}
+
+html.light .topbar-status strong,
+html.light .month-progress-card strong { color: #1d3650; }
+
+html.light .topbar-status div span,
+html.light .page-intro p,
+html.light .month-progress-card > div:first-child,
+html.light .month-progress-card small,
+html.light .dashboard-quick-actions small,
+html.light .income-disclaimer,
+html.light .hero-proof { color: var(--muted); }
+
+html.light .theme-toggle,
+html.light .profile-menu-trigger,
+html.light .month-progress-card,
+html.light .dashboard-quick-actions > a {
+  border-color: #bcc8d4;
+  color: #243f5a;
+  background: #e4eaf0;
+}
+
+html.light .profile-dropdown {
+  border-color: #b9c6d3;
+  background: #eef2f6;
+  box-shadow: 0 24px 60px rgba(29, 50, 77, .18);
+}
+
+html.light .profile-dropdown-section > a,
+html.light .profile-dropdown-section .theme-toggle { color: #2c4864; }
+html.light .profile-dropdown-section > a:hover,
+html.light .profile-dropdown-section .theme-toggle:hover { color: #14283f; background: #dde5ec; }
+
+html.light .card,
+html.light .page-intro,
+html.light .finance-hero,
+html.light .transaction-dialog,
+html.light .grocery-market-card,
+html.light .income-ideas-card {
+  border-color: #becad6;
+  color: var(--text);
+  background: linear-gradient(180deg, #f5f7fa, #edf2f6);
+  box-shadow: 0 15px 36px rgba(42, 61, 82, .09), inset 0 1px 0 rgba(255, 255, 255, .8);
+}
+
+html.light .card:hover { border-color: #aebdcb; box-shadow: 0 19px 42px rgba(42, 61, 82, .12); }
+
+html.light .safe-spend-grid > div,
+html.light .weather-days > div,
+html.light .goal-line,
+html.light .budget-line,
+html.light .preference-card,
+html.light .threshold-panel,
+html.light .grocery-price,
+html.light .income-idea,
+html.light .profile-photo-panel,
+html.light .landing-preview-row > div,
+html.light .landing-weather-strip,
+html.light .landing-benefit-grid article {
+  border-color: #c5d0db;
+  color: var(--text);
+  background: #e4eaf0;
+}
+
+html.light .dashboard-details { border-color: #bdc9d5; background: rgba(238, 242, 246, .92); }
+html.light .grocery-price > strong,
+html.light .market-source-row a,
+html.light .landing-preview-balance > span { color: #087047; }
+html.light .income-idea > span { color: #245f99; background: rgba(36, 95, 153, .1); }
+html.light .health-card-inner { color: var(--text); background: #dde5ec; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7); }
+html.light .safe-spend-grid > div:hover,
+html.light .weather-days > div:hover { background: #dbe4ec; }
+html.light .eco-tip { border-color: rgba(8, 122, 75, .2); color: #20583f; background: rgba(8, 122, 75, .08); }
+html.light .progress { background: #c9d4de; box-shadow: inset 0 1px 2px rgba(42, 61, 82, .13); }
+html.light .page-feature-pill { border-color: #b7c5d2; color: #29445f; background: rgba(228, 234, 240, .88); }
+html.light .marketing-nav nav a,
+html.light .marketing-login { color: #405a74; }
+html.light .marketing-nav nav a:hover,
+html.light .marketing-login:hover { color: #0d5f3c; }
+html.light th { color: #435c75; }
+html.light td { border-bottom-color: #c6d1dc; }
+html.light .transaction-privacy { color: #536b83; }
+html.light .transaction-table tbody tr:hover,
+html.light tbody tr:hover { background: rgba(8, 122, 75, .06); }
+
+html.light input,
+html.light select,
+html.light textarea {
+  border-color: #b7c4d0;
+  color: var(--text);
+  background: #edf2f6;
+  box-shadow: inset 0 1px 1px rgba(42, 61, 82, .04);
+}
+
+html.light input:hover,
+html.light select:hover,
+html.light textarea:hover { border-color: #91a5b9; }
+
+html.light input:focus,
+html.light select:focus,
+html.light textarea:focus {
+  border-color: #087a4b;
+  background: #f5f7fa;
+  box-shadow: 0 0 0 4px rgba(8, 122, 75, .12);
+}
+
+html.light .btn { border-color: #b8c5d1; color: #1f3a55; background: #e2e8ee; }
+html.light .btn:hover:not(:disabled) { border-color: #91a5b9; background: #d9e1e8; }
+html.light .btn-primary { border-color: transparent; color: #fff; background: linear-gradient(135deg, #0a925a, #087047); }
+
+html.light .landing-v3,
+html.light .auth-wrap { background: transparent; }
+
+html.light .landing-dashboard-preview {
+  border-color: #b9c6d3;
+  color: var(--text);
+  background: #eef2f6;
+  box-shadow: 0 28px 70px rgba(42, 61, 82, .14);
+}
+
+html.light .landing-preview-balance {
+  border-color: rgba(8, 122, 75, .24);
+  background: linear-gradient(135deg, rgba(8, 122, 75, .1), rgba(41, 105, 176, .07));
+}
+
+html.light .error { border-color: #d79aa4; color: #8f2638; background: #f3e0e4; }
+html.light .success { border-color: #82bfa4; color: #075c3b; background: #dceee5; }
+
+@media (max-width: 760px) {
+  .marketing-nav-clean .marketing-brand,
+  .marketing-nav-clean .brand-logo { width: 174px; }
+}
-- 
2.51.1

